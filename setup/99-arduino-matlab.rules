# MATLAB R2014b on Linux only recognises serial ports named /dev/ttyS*.
# This recreates /dev/ttyS101 -> the Arduino whenever one is plugged in.
#
# Install:
#   sudo cp 99-arduino-matlab.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
KERNEL=="ttyACM[0-9]*", SYMLINK+="ttyS101"
